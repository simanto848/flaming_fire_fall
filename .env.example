# Backend API origin used by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional: point the super-intelligence at any OpenAI-compatible provider ---
# Defaults to local Ollama (lfm3-omni:latest) which supports vision + tools + audio.
# SHUNNO_LLM_BASE_URL=http://localhost:11434/v1
# SHUNNO_LLM_MODEL=lfm3-omni:latest
# SHUNNO_LLM_API_KEY=ollama
# SHUNNO_VISION_MODEL=qwen2.5vl:3b
#
# Cloud example (OpenAI / Groq / OpenRouter):
# SHUNNO_LLM_BASE_URL=https://api.openai.com/v1
# SHUNNO_LLM_MODEL=gpt-4o-mini
# SHUNNO_LLM_API_KEY=sk-...